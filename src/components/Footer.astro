---
import WaterLine from "./WaterLine.astro";
import FutureLink from "./FutureLink.astro";
import Wordmark from "./Wordmark.astro";
import { socials, generalEmail, FUTURE } from "../data/site";
const future = ["Новини", "Відгуки", "Про санаторій", "Політика конфіденційності"];
---
<footer class="site-footer">
  <WaterLine />
  <div class="container grid footer__grid">
    <Wordmark class="footer__mark" />
    <ul class="footer__social" aria-label="Соціальні мережі" data-rec="S-R016">
      {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener" aria-label={`${s.name} санаторію «Конча-Заспа» (відкриється в новій вкладці)`}>{s.name}</a></li>)}
    </ul>
    <a class="footer__mail" href={`mailto:${generalEmail}`}>{generalEmail}</a>
    <ul class="footer__future" aria-label="Інші розділи">
      {future.map((f) => <li><FutureLink note={FUTURE}>{f}</FutureLink></li>)}
    </ul>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-deep); color: var(--color-on-deep); }
  .site-footer :focus-visible { outline-color: var(--color-focus-deep); }
  .footer__grid { row-gap: var(--space-5); align-items: center; padding-block: var(--space-8) var(--space-9); }
  .footer__grid :global(.footer__mark) { grid-column: 1 / span 3; }
  .footer__social { grid-column: 4 / span 5; display: flex; flex-wrap: wrap; column-gap: var(--space-6); }
  .footer__social a, .footer__mail { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .footer__social a:hover, .footer__mail:hover { color: var(--color-on-deep-muted); text-decoration: underline; text-underline-offset: 0.2em; }
  .footer__social a:active, .footer__mail:active { color: var(--color-brand); }
  .footer__mail { grid-column: 9 / -1; justify-self: end; }
  .footer__future { grid-column: 1 / -1; display: flex; flex-wrap: wrap; column-gap: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--color-deep-rule); font-size: var(--text-small); }
  .footer__future :global(.future-link[aria-disabled="true"]) { color: var(--color-on-deep-muted); white-space: nowrap; }
  .footer__future :global(.future-link[aria-disabled="true"]:hover) { color: var(--color-on-deep); }
  .footer__future :global(.future-link__note[aria-hidden="true"]) { background: var(--color-on-deep); color: var(--color-text); }

  @media (max-width: 1023px) {
    .footer__grid :global(.footer__mark), .footer__social, .footer__mail { grid-column: 1 / -1; justify-self: start; }
  }
  @media (max-width: 767px) {
    .footer__grid { padding-bottom: calc(var(--space-9) + var(--control) + var(--space-4)); }
  }
</style>
