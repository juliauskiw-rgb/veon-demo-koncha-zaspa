---
// Client photo from public/img (AVIF + WebP made by scripts/build-photos.mjs). Paths go through BASE_URL
// because the demo is published in a sub-folder. `sizes`/`srcset` only where a second width exists.
interface Source { name: string; w: number; }
interface Props {
  name: string; width: number; height: number; alt: string;
  srcset?: Source[]; sizes?: string; eager?: boolean; class?: string;
  mobile?: { name: string; width: number; height: number };
}
const { name, width, height, alt, srcset, sizes, eager = false, class: cls, mobile } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (n: string, ext: string) => `${base}img/${n}.${ext}`;
const set = (ext: string) => (srcset ? srcset.map((s) => `${url(s.name, ext)} ${s.w}w`).join(", ") : url(name, ext));
---
<picture class={cls}>
  {mobile && <source media="(max-width: 767px)" type="image/avif" srcset={url(mobile.name, "avif")} width={mobile.width} height={mobile.height} />}
  {mobile && <source media="(max-width: 767px)" type="image/webp" srcset={url(mobile.name, "webp")} width={mobile.width} height={mobile.height} />}
  <source type="image/avif" srcset={set("avif")} sizes={srcset ? sizes : undefined} />
  <img
    src={url(name, "webp")}
    srcset={srcset ? set("webp") : undefined}
    sizes={srcset ? sizes : undefined}
    width={width}
    height={height}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding={eager ? "sync" : "async"}
    fetchpriority={eager ? "high" : undefined}
  />
</picture>
