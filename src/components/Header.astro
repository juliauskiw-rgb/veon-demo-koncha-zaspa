---
import Wordmark from "./Wordmark.astro";
import Button from "./Button.astro";
import FutureLink from "./FutureLink.astro";
import PhoneIcon from "./PhoneIcon.astro";
import { nav, reception, medManager, FUTURE } from "../data/site";
const main = reception.phones[0];
---
<header class="site-header" data-header>
  <div class="container header__row">
    <Wordmark />
    <nav class="header__nav" aria-label="Розділи головної" data-rec="U-R005">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="header__actions">
      <a class="header__phone" href={`tel:${main.tel}`}><span class="visually-hidden">Ресепшн: </span>{main.display}</a>
      <Button href={`tel:${main.tel}`} tone="action" class="header__call" icon={false}>Зателефонувати</Button>
      <p class="lang header__lang"><span class="lang__current" aria-current="true">UA</span><FutureLink note={FUTURE} class="lang__other">RU</FutureLink></p>
      <a class="header__icon-call" href={`tel:${main.tel}`} data-rec="U-R004" aria-label="Зателефонувати на ресепшн">
        <PhoneIcon size={22} />
      </a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu" data-burger>
        <span class="burger__bars" aria-hidden="true"><span></span><span></span></span>
        <span class="visually-hidden" data-burger-label>Відкрити меню</span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu" hidden data-menu>
    <div class="container menu__inner">
      <nav aria-label="Меню">
        <ul class="menu__nav">
          {nav.map((item) => <li><a href={item.href} data-menu-link>{item.label}</a></li>)}
        </ul>
      </nav>
      <div class="menu__contacts">
        <p class="menu__role">{reception.role}, {reception.hours}</p>
        {reception.phones.map((p) => <a class="menu__phone" href={`tel:${p.tel}`}><span class="visually-hidden">Тел. </span>{p.display}</a>)}
        <p class="menu__role">{medManager.role}, {medManager.hours}</p>
        <a class="menu__phone" href={`tel:${medManager.phone.tel}`}><span class="visually-hidden">Тел. </span>{medManager.phone.display}</a>
        <a class="menu__mail" href={`mailto:${reception.email}`}>{reception.email}</a>
      </div>
      <p class="lang menu__lang"><span class="lang__current" aria-current="true">UA</span><FutureLink note={FUTURE} class="lang__other">RU</FutureLink></p>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--color-bg); border-bottom: 1px solid transparent; transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out); }
  .site-header.is-scrolled { border-bottom-color: var(--color-border); box-shadow: var(--shadow-md); }
  .header__row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); min-height: 76px; }
  .header__nav { display: none; }
  .header__nav ul { display: flex; gap: var(--space-6); }
  .header__nav a, .header__phone {
    position: relative; display: inline-flex; align-items: center; min-height: 44px;
    font-size: var(--text-small); font-weight: 600; text-decoration: none; white-space: nowrap;
  }
  .header__nav a::after, .header__phone::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: var(--space-2); height: var(--line);
    background: var(--color-brand); transform: scaleX(0); transform-origin: 0 50%; transition: transform 200ms var(--ease-out);
  }
  .header__nav a:hover::after, .header__phone:hover::after { transform: scaleX(1); }
  .header__nav a:active, .header__phone:active { color: var(--color-action); }
  .header__phone { display: none; font-variant-numeric: tabular-nums; font-size: var(--text-body); }
  .header__actions { display: flex; align-items: center; gap: var(--space-4); }
  .header__actions :global(.header__call) { min-height: var(--control-sm); padding-inline: var(--space-5); font-size: var(--text-small); }

  .lang { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-small); font-weight: 600; }
  .lang__current { color: var(--color-text); }
  .header__lang { display: none; }
  .lang :global(.lang__other) { min-height: 44px; padding-inline: var(--space-1); color: var(--color-muted); }

  .header__icon-call, .burger {
    display: none; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0;
    border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--color-text); cursor: pointer;
  }
  .header__icon-call { background: var(--color-action); color: var(--color-action-ink); }
  .header__icon-call:hover { background: var(--color-action-hover); }
  .header__icon-call:active, .burger:active { background: var(--color-text); color: var(--color-bg); }
  .burger:hover { background: var(--color-surface); }
  .burger:disabled { opacity: .5; cursor: not-allowed; }
  .burger__bars { display: grid; gap: var(--space-2); width: 22px; }
  .burger__bars span { display: block; height: var(--line); background: currentColor; transition: transform var(--dur-fast) var(--ease-out); }
  .burger[aria-expanded="true"] .burger__bars span:first-child { transform: translateY(5px) rotate(45deg); }
  .burger[aria-expanded="true"] .burger__bars span:last-child { transform: translateY(-5px) rotate(-45deg); }

  :global(.js) .burger { display: inline-flex; }

  .menu {
    position: fixed; inset: 76px 0 0 0; z-index: 49; overflow-y: auto;
    background: var(--color-deep); color: var(--color-on-deep);
    border-top: var(--line) solid var(--color-brand);
  }
  .menu[hidden] { display: none; }
  .menu__inner { display: grid; gap: var(--space-7); padding-block: var(--space-7) var(--space-9); }
  .menu__nav { display: grid; gap: var(--space-1); }
  .menu__nav a { display: flex; align-items: center; min-height: 52px; font-family: var(--font-display); font-weight: 600; font-size: var(--text-title); line-height: 1.1; text-decoration: none; }
  .menu__nav a:hover { color: var(--color-on-deep-muted); }
  .menu__nav a:active { color: var(--color-brand); }
  .menu a:focus-visible, .menu :global(.future-link:focus-visible) { outline-color: var(--color-focus-deep); }
  .menu__contacts { display: grid; gap: var(--space-2); justify-items: start; }
  .menu__role { font-size: var(--text-small); color: var(--color-on-deep-muted); margin-top: var(--space-3); }
  .menu__role:first-child { margin-top: 0; }
  .menu__phone { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--text-title); font-variant-numeric: tabular-nums; text-decoration: none; }
  .menu__mail { display: inline-flex; align-items: center; min-height: 44px; margin-top: var(--space-3); color: var(--color-on-deep-muted); }
  .menu__phone:hover, .menu__mail:hover { color: var(--color-brand); }
  .menu__phone:active, .menu__mail:active { color: var(--color-on-deep); }
  .menu__lang .lang__current { color: var(--color-on-deep); }
  .menu__lang :global(.lang__other) { color: var(--color-on-deep-muted); }

  @media (max-width: 767px) {
    .header__row { min-height: 64px; gap: var(--space-3); }
    .header__actions { gap: var(--space-2); }
    .header__actions :global(.header__call) { display: none; }
    .header__icon-call { display: inline-flex; }
    .menu { inset-block-start: 64px; }
  }
  @media (min-width: 1180px) {
    .header__nav { display: block; }
    .header__lang { display: flex; }
    :global(.js) .burger { display: none; }
    .menu { display: none !important; }
  }
  @media (min-width: 1320px) {
    .header__phone { display: inline-flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header, .burger__bars span, .header__nav a::after, .header__phone::after { transition: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const label = document.querySelector<HTMLElement>("[data-burger-label]");

  if (header) {
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (burger && menu) {
    const focusables = (): HTMLElement[] => [burger, ...menu.querySelectorAll<HTMLElement>('a[href], [tabindex="0"]')];
    const setOpen = (open: boolean, restoreFocus = true) => {
      burger.setAttribute("aria-expanded", String(open));
      if (label) label.textContent = open ? "Закрити меню" : "Відкрити меню";
      menu.hidden = !open;
      document.documentElement.classList.toggle("menu-open", open);
      if (open) menu.querySelector<HTMLElement>("a[href]")?.focus();
      else if (restoreFocus) burger.focus();
    };
    burger.addEventListener("click", () => setOpen(burger.getAttribute("aria-expanded") !== "true"));
    menu.querySelectorAll("[data-menu-link]").forEach((a) => a.addEventListener("click", () => setOpen(false, false)));
    document.addEventListener("keydown", (e) => {
      if (menu.hidden) return;
      if (e.key === "Escape") { setOpen(false); return; }
      if (e.key !== "Tab") return;
      const list = focusables();
      const first = list[0];
      const last = list[list.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
    window.matchMedia("(min-width: 1180px)").addEventListener("change", (m) => { if (m.matches && !menu.hidden) setOpen(false, false); });
  }
</script>
