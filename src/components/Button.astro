---
// Call-to-action link. tone: "action" on white or sand, "brand" on the deep lake, "dark" on the blue reception card.
import PhoneIcon from "./PhoneIcon.astro";
interface Props { href: string; tone?: "action" | "brand"; icon?: boolean; full?: boolean; class?: string; [key: string]: unknown; }
const { href, tone = "action", icon = true, full = false, class: cls, ...rest } = Astro.props;
---
<a href={href} class:list={["btn", `btn--${tone}`, { "btn--full": full }, cls]} {...rest}>
  {icon && <PhoneIcon class="btn__icon" size={20} />}
  <span><slot /></span>
</a>

<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-3);
    min-height: var(--control); padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-sm); font-family: var(--font-body); font-size: var(--text-body); font-weight: 600; line-height: 1.2;
    text-decoration: none; white-space: nowrap; cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .btn--full { display: flex; width: 100%; padding-inline: var(--space-4); }
  .btn :global(.btn__icon) { flex: none; transition: transform var(--dur-fast) var(--ease-out); }
  .btn--action { background: var(--color-action); color: var(--color-action-ink); }
  .btn--action:hover { background: var(--color-action-hover); }
  .btn--brand { background: var(--color-brand); color: var(--color-brand-ink); }
  .btn--brand:hover { background: var(--color-brand-hover); }
  .btn--brand:focus-visible { outline-color: var(--color-focus-deep); }
  .btn:hover :global(.btn__icon) { transform: translateX(3px); }
  .btn:active { transform: scale(.98); }
  .btn:active :global(.btn__icon) { transform: none; }
  @media (hover: none) { .btn:hover :global(.btn__icon) { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .btn, .btn :global(.btn__icon) { transition: none; } .btn:hover :global(.btn__icon), .btn:active { transform: none; } }
</style>
