---
import Section from "../Section.astro";
import FutureLink from "../FutureLink.astro";
import { medManager, FUTURE } from "../../data/site";

// B-F011: roles from the doctors page; names and portraits wait for the client (U-R010).
const team = [
  "фізичні терапевти",
  "лікар фізичної та реабілітаційної медицини",
  "пульмонолог, кандидат медичних наук",
  "психолог",
  "ерготерапевт",
  "логопед-афазіолог",
];
---
<Section id="komanda" class="block block--deep komanda" rec="U-R009">
  <div class="container grid komanda__grid">
    <p class="komanda__figure" data-reveal>
      <span class="komanda__n nums">~200</span>
      <span class="komanda__t">співробітників працює в санаторії</span>
    </p>
    <div class="komanda__main">
      <div class="head komanda__head" data-reveal style="--reveal-delay: 60ms">
        <h2 class="h-section">Хто вас лікуватиме</h2>
      </div>
      <p class="komanda__lead">Команда реабілітації:</p>
      <ul class="komanda__list" data-reveal style="--reveal-delay: 120ms">
        {team.map((t) => <li>{t}</li>)}
      </ul>
      <p class="futures komanda__links">
        <a class="text-link" href={`tel:${medManager.phone.tel}`}>Запитати медичного менеджера</a>
        <FutureLink note={FUTURE}>Усі лікарі</FutureLink>
      </p>
    </div>
  </div>
</Section>

<style>
  .komanda__grid { row-gap: var(--space-6); align-items: start; }
  .komanda__figure { grid-column: 1 / span 5; display: grid; gap: var(--space-2); }
  .komanda__n { font-family: var(--font-display); font-size: var(--text-figure-xl); font-weight: 700; line-height: 1; letter-spacing: -0.03em; }
  .komanda__t { font-size: var(--text-lede); color: var(--color-on-deep-muted); max-width: 22ch; }
  .komanda__main { grid-column: 6 / -1; display: grid; gap: var(--space-4); justify-items: start; }
  .komanda__lead { color: var(--color-on-deep-muted); margin-top: var(--space-2); }
  .komanda__list { width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); font-size: var(--text-lede); }
  .komanda__list li { padding-block: var(--space-3); border-top: 1px solid var(--color-deep-rule); }

  @media (max-width: 1023px) {
    .komanda__figure, .komanda__main { grid-column: 1 / -1; }
  }
  @media (max-width: 767px) {
    .komanda__list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
