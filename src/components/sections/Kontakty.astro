---
import Section from "../Section.astro";
import Button from "../Button.astro";
import { reception, medManager, address } from "../../data/site";
---
<Section id="kontakty" class="block kontakty" rec="U-R001">
  <div class="container grid kontakty__grid">
    <div class="head kontakty__head" data-reveal>
      <h2 class="h-section">Як зв’язатися і доїхати</h2>
    </div>

    <article class="contact contact--reception" data-reveal>
      <h3 class="h-title">{reception.role}</h3>
      <p class="contact__task">{reception.task}, <span class="nowrap">{reception.hours}</span></p>
      <div class="contact__phones">
        {reception.phones.map((p) => <a class="tel contact__tel" href={`tel:${p.tel}`}><span class="visually-hidden">Тел. </span>{p.display}</a>)}
      </div>
      <a class="contact__mail" href={`mailto:${reception.email}`}>{reception.email}</a>
      <Button href={`tel:${reception.phones[0].tel}`} tone="brand" class="contact__btn">Зателефонувати</Button>
    </article>

    <article class="card contact contact--med" data-reveal style="--reveal-delay: 60ms">
      <h3 class="h-title">{medManager.role}</h3>
      <p class="contact__task">{medManager.task}, <span class="nowrap">{medManager.hours}</span></p>
      <div class="contact__phones">
        <a class="tel contact__tel" href={`tel:${medManager.phone.tel}`}><span class="visually-hidden">Тел. </span>{medManager.phone.display}</a>
      </div>
      <a class="text-link contact__mail" href={`mailto:${medManager.email}`}>{medManager.email}</a>
    </article>

    <article class="contact contact--road" data-reveal style="--reveal-delay: 120ms">
      <h3 class="h-title">Як доїхати</h3>
      <address class="contact__address">{address.postal}, {address.line}</address>
      <p class="contact__task">{address.route}</p>
      <a class="text-link" href={address.map} target="_blank" rel="noopener" data-rec="U-R012">Відкрити на карті<span class="visually-hidden"> (нова вкладка)</span></a>
    </article>
  </div>
</Section>

<style>
  .kontakty__grid { row-gap: var(--space-5); align-items: stretch; }
  .kontakty__head { margin-bottom: var(--space-3); }
  .contact { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2); padding: var(--space-6); border-radius: var(--radius); }
  .contact--reception { grid-column: 1 / span 5; background: var(--color-deep); color: var(--color-on-deep); }
  .contact--med { grid-column: 6 / span 3; box-shadow: var(--shadow-md); }
  .contact--road { grid-column: 9 / -1; background: var(--color-sand); }
  .contact__task { color: var(--color-muted); }
  .contact--reception .contact__task { color: var(--color-on-deep-muted); }
  .contact__phones { display: grid; justify-items: start; margin-top: var(--space-2); }
  .contact__tel { font-family: var(--font-display); font-size: var(--text-phone); font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; }
  .contact__mail { display: inline-flex; align-items: center; min-height: 44px; white-space: nowrap; }
  .contact--reception .contact__mail { color: var(--color-on-deep); font-weight: 600; }
  .contact--reception .contact__mail:hover { text-decoration-thickness: 2px; }
  .contact--reception .contact__mail:active, .contact--reception .contact__tel:active { color: var(--color-deep); }
  .contact--reception :focus-visible { outline-color: var(--color-focus-deep); }
  .contact :global(.contact__btn) { margin-top: auto; }
  .contact__address { font-style: normal; font-size: var(--text-lede); font-weight: 400; }
  .contact--road .text-link { margin-top: auto; }

  @media (max-width: 1179px) {
    .contact--reception { grid-column: 1 / -1; }
    .contact--med, .contact--road { grid-column: span 6; }
  }
  @media (max-width: 767px) {
    .contact { padding: var(--space-5); }
    .contact--med, .contact--road { grid-column: 1 / -1; }
    .contact :global(.contact__btn) { width: 100%; }
  }
</style>
