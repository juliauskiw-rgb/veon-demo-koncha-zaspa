---
import Section from "../Section.astro";
import FutureLink from "../FutureLink.astro";
import Picture from "../Picture.astro";
import { medManager, FUTURE } from "../../data/site";

const profiles = ["кардіологія", "неврологія", "ортопедія і травматологія", "фізична реабілітація", "психотерапія"];
const spa = ["Detox Day", "Wellness-Day", "термо-SPA", "душ Шарко"];
const sanatorne = ["санаторно-курортне лікування", "фізіотерапія", "амбулаторне лікування", "сімейний відпочинок"];
const diag = ["функціональна діагностика", "УЗД", "лабораторія запаморочення", "електронейроміографія"];
---
<Section id="napryamy" class="block napryamy" rec="U-R006">
  <div class="container grid napryamy__grid">
    <div class="head napryamy__head" data-reveal>
      <h2 class="h-section">З чим до нас звертаються</h2>
    </div>

    <article class="card rehab" data-reveal>
      <div class="rehab__text">
        <h3 class="rehab__h">Реабілітація</h3>
        <p class="rehab__lead">П'ять профілів і мультидисциплінарна команда: фізичні терапевти, ерготерапевт, логопед-афазіолог, психолог.</p>
        <ul class="chips">
          {profiles.map((p) => <li class="chip">{p}</li>)}
        </ul>
        <p class="rehab__ask">Чи лікують ваш випадок, підкаже медичний менеджер: <a class="text-link nums nowrap" href={`tel:${medManager.phone.tel}`}>{medManager.phone.display}</a></p>
        <FutureLink note={FUTURE}>Усе про реабілітацію</FutureLink>
      </div>
    </article>

    <article class="spa" data-reveal style="--reveal-delay: 60ms">
      <figure class="spa__photo photo">
        <Picture name="spa-basein" width={362} height={195} alt="Критий басейн санаторію з пальмою біля води" />
      </figure>
      <h3 class="h-title">SPA</h3>
      <ul class="chips">
        {spa.map((p) => <li class="chip">{p}</li>)}
      </ul>
      <div class="spa__float">
        <figure class="spa__float-photo photo">
          <Picture name="floating" width={240} height={180} alt="Капсула для флоатингу" />
        </figure>
        <p><strong>Флоатинг</strong> у капсулі, басейн, сауни й підводний душ-масаж</p>
      </div>
      <FutureLink note={FUTURE}>SPA-програми</FutureLink>
    </article>

    <article class="line line--wide" data-reveal style="--reveal-delay: 60ms">
      <h3 class="h-title">Санаторно-курортне лікування та профілактика</h3>
      <ul class="chips chips--white">{sanatorne.map((p) => <li class="chip">{p}</li>)}</ul>
      <FutureLink note={FUTURE}>Санаторне лікування</FutureLink>
    </article>

    <article class="line" data-reveal style="--reveal-delay: 120ms">
      <h3 class="h-title">Діагностика</h3>
      <ul class="chips chips--white">{diag.map((p) => <li class="chip">{p}</li>)}</ul>
      <FutureLink note={FUTURE}>Діагностика</FutureLink>
    </article>

    <p class="napryamy__also">Також у санаторії: <FutureLink note={FUTURE}>Жіноче коло</FutureLink><FutureLink note={FUTURE}>конференц-сервіс</FutureLink><FutureLink note={FUTURE}>б'юті-послуги</FutureLink></p>
  </div>
</Section>

<style>
  .napryamy { padding-top: calc(var(--section-pad) * 1.75); }
  .napryamy__grid { row-gap: var(--space-5); }
  .napryamy__head { margin-bottom: var(--space-3); }

  .napryamy__grid { grid-template-areas: "head head head head head head head head head head head head" "rehab rehab rehab rehab rehab rehab rehab rehab spa spa spa spa" "san san san san diag diag diag diag spa spa spa spa" "also also also also also also also also also also also also"; align-items: start; }
  .napryamy__head { grid-area: head; }
  .rehab { grid-area: rehab; padding: var(--space-6); box-shadow: var(--shadow-md); }
  .rehab__text { display: grid; align-content: start; justify-items: start; gap: var(--space-4); }
  .rehab .chips { max-width: 60ch; }
  .rehab__h { font-family: var(--font-display); font-size: clamp(1.5rem, 1.21rem + 1.19vw, 2rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; }
  .rehab__lead { color: var(--color-muted); max-width: 46ch; }
  .rehab__ask { color: var(--color-muted); }
  .rehab__ask .text-link { min-height: 24px; }

  .spa { grid-area: spa; display: grid; align-content: start; justify-items: start; gap: var(--space-4); }
  .spa__photo { width: 100%; max-width: 362px; aspect-ratio: 362 / 195; }
  .spa__float { display: grid; grid-template-columns: 120px minmax(0, 1fr); align-items: center; gap: var(--space-4); width: 100%; padding: var(--space-3); border-radius: var(--radius-sm); background: var(--color-tint); font-size: var(--text-small); }
  .spa__float-photo { aspect-ratio: 4 / 3; border-radius: var(--space-2); }

  .line { grid-area: diag; display: grid; align-content: start; justify-items: start; gap: var(--space-4); padding: var(--space-6); border-radius: var(--radius); background: var(--color-sand); }
  .line--wide { grid-area: san; }
  .chips--white .chip { background: var(--color-surface); }

  .napryamy__also { grid-area: also; display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-5); color: var(--color-muted); padding-top: var(--space-2); }

  @media (max-width: 1023px) {
    .napryamy__grid { grid-template-areas: "head" "rehab" "spa" "san" "diag" "also"; grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 767px) {
    .rehab { padding: var(--space-5); }
    .line { padding: var(--space-5); }
    .spa__float { grid-template-columns: 104px minmax(0, 1fr); }
  }
</style>
