---
import Section from "../Section.astro";
import FutureLink from "../FutureLink.astro";
import Button from "../Button.astro";
import { reception, FUTURE } from "../../data/site";

// B-F012: what the voucher includes. Icons are 24 px line drawings in the action blue, no coin behind them.
const includes = [
  { t: "Проживання", d: "у номерах I та II корпусів", icon: "bed" },
  { t: "Базове лікування", d: "входить у вартість путівки", icon: "care" },
  { t: "Повний пансіон", d: "харчування на весь заїзд", icon: "meal" },
];
// B-F015: room categories.
const rooms = [
  { t: "Одномісні та двомісні", rows: ["I корпус", "II корпус", "II корпус, I поверх", "покращені"] },
  { t: "Дво- й трикімнатні", rows: ["двокімнатні стандарт", "двокімнатні «люкс»", "двокімнатні тримісні", "трикімнатний люкс"] },
];
// Dated promotion B-F014: shown only until 30.11.2026 inclusive (build date check).
const promoActive = new Date() <= new Date("2026-11-30T23:59:59+02:00");
---
<Section id="putivka" class="block block--sand putivka">
  <div class="container grid putivka__grid">
    <div class="head putivka__head" data-reveal>
      <h2 class="h-section">Що входить у путівку</h2>
      <p class="putivka__answer">Проживання, базове лікування і повний пансіон: путівка від 12 днів</p>
    </div>
    <div class="putivka__terms" data-reveal style="--reveal-delay: 60ms">
      <p class="term">−20% особам з інвалідністю та дітям <span class="nowrap">4–18 років</span></p>
      {promoActive && (
        <p class="term term--dated" data-rec="U-R018">«Осінь — час подбати про себе»: −15% на проживання в обраних категоріях до <time datetime="2026-11-30">30.11.2026</time></p>
      )}
    </div>

    <ul class="includes">
      {includes.map((x, i) => (
        <li class="card include" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
          <h3 class="include__t"><svg class="include__icon" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              {x.icon === "bed" && <path d="M3 18V7m0 6h18v5M21 13a3 3 0 0 0-3-3h-7v3M7 11.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" />}
              {x.icon === "care" && <path d="M6 3v5a4 4 0 0 0 8 0V3M10 12v3a5 5 0 0 0 10 0v-2M20 13a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" />}
              {x.icon === "meal" && <path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM2 4v5M2 9v11M22 4c-1.5 1-1.5 4 0 5v11" />}
            </svg>{x.t}</h3>
          <p class="include__d">{x.d}</p>
        </li>
      ))}
    </ul>

    <div class="rooms" data-rec="U-R008">
      <h3 class="h-title rooms__h">Номери</h3>
      {rooms.map((r, i) => (
        <div class="card room" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
          <h4 class="room__t">{r.t}</h4>
          <ul class="room__rows">{r.rows.map((row) => <li>{row}</li>)}</ul>
        </div>
      ))}
    </div>

    <div class="putivka__price">
      <p>Вартість і вільні дати підкаже ресепшн.</p>
      <Button href={`tel:${reception.phones[0].tel}`} tone="action">Зателефонувати на ресепшн</Button>
      <p class="futures"><FutureLink note={FUTURE}>Усі ціни</FutureLink><FutureLink note={FUTURE}>Номери</FutureLink></p>
    </div>
  </div>
</Section>

<style>
  .putivka__grid { row-gap: var(--space-6); align-items: end; }
  .putivka__head { grid-column: 1 / span 7; }
  .putivka__answer { font-family: var(--font-display); font-size: var(--text-title); font-weight: 600; line-height: 1.3; max-width: 30ch; margin-top: var(--space-2); }
  .putivka__terms { grid-column: 8 / -1; display: grid; gap: var(--space-3); justify-items: start; }
  .term { padding: var(--space-2) var(--space-4); border-radius: var(--radius-sm); background: var(--color-bark); color: var(--color-bark-ink); font-weight: 600; font-size: var(--text-small); }
  .term--dated { background: transparent; color: var(--color-bark); border: 1px solid var(--color-bark); }

  .includes { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 4fr); gap: var(--space-4); }
  .include { display: grid; gap: var(--space-1); align-content: start; padding: var(--space-5); }
  .include__t { display: flex; align-items: center; gap: var(--space-3); font-family: var(--font-display); font-size: var(--text-lede); font-weight: 700; line-height: 1.2; }
  .include__d { color: var(--color-muted); font-size: var(--text-small); }
  .include__icon { flex: none; color: var(--color-action); }
  .include__d { padding-left: calc(24px + var(--space-3)); }

  .rooms { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-5); row-gap: var(--space-4); }
  .rooms__h { grid-column: 1 / -1; }
  .room { grid-column: span 6; padding: var(--space-5) var(--space-6); box-shadow: var(--shadow-md); }
  .room__t { font-weight: 700; font-size: var(--text-body); margin-bottom: var(--space-2); }
  .room__rows li { padding-block: var(--space-2); border-top: 1px solid var(--color-border); color: var(--color-muted); }

  .putivka__price { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-6); row-gap: var(--space-4); padding-top: var(--space-2); }
  .putivka__price > p:first-child { font-size: var(--text-lede); font-weight: 400; }
  .putivka__price .futures { margin-left: auto; }

  @media (max-width: 1023px) {
    .putivka__head, .putivka__terms { grid-column: 1 / -1; }
    .includes { grid-template-columns: minmax(0, 1fr); }
    .putivka__price .futures { margin-left: 0; }
  }
  @media (max-width: 767px) {
    .room { grid-column: 1 / -1; padding: var(--space-4) var(--space-5); }
    .putivka__price :global(.btn) { display: flex; width: 100%; }
  }
</style>
