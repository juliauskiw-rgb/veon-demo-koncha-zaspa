---
// Text wordmark until the client's vector logo arrives (B-F017). Leads to the top of the homepage.
interface Props { class?: string; }
const { class: cls } = Astro.props;
---
<a href="#hero" class:list={["wordmark", cls]} aria-label="Санаторій «Конча-Заспа», на початок сторінки">
  <span class="wordmark__name">Конча-Заспа</span>
  <span class="wordmark__kind">санаторій</span>
</a>

<style>
  .wordmark { display: inline-flex; gap: var(--space-2); text-decoration: none; color: inherit; white-space: nowrap; min-height: 44px; align-items: center; }
  .wordmark__name { font-family: var(--font-display); font-weight: 500; font-size: 1.375rem; line-height: 1; letter-spacing: -0.01em; }
  .wordmark__kind { font-size: var(--text-small); font-weight: 600; line-height: 1; color: var(--color-muted); }
  .wordmark:hover .wordmark__name { color: var(--color-action); }
  .wordmark:active .wordmark__name { color: var(--color-text); }
  @media (max-width: 359px) { .wordmark__kind { display: none; } }
</style>
