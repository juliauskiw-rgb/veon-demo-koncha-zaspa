---
// Text wordmark until the client's vector logo arrives (B-F017). Leads to the top of the homepage.
interface Props { class?: string; }
const { class: cls } = Astro.props;
---
<a href="#hero" class:list={["wordmark", cls]} aria-label="Санаторій «Конча-Заспа», на початок сторінки">
  <span class="wordmark__name">Конча-Заспа</span>
  <span class="wordmark__kind">санаторій</span>
</a>

<style>
  .wordmark { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; text-decoration: none; color: inherit; white-space: nowrap; }
  .wordmark__name { font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; line-height: 1; letter-spacing: -0.02em; }
  .wordmark__kind { font-size: 0.8125rem; font-weight: 400; line-height: 1; opacity: .78; }
  .wordmark:hover .wordmark__name { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .wordmark:active .wordmark__name { text-decoration: none; }
  @media (max-width: 359px) { .wordmark__kind { display: none; } }
</style>
